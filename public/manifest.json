{
  "manifest_version": 3,
  "name": "Chủ đề Zalo",
  "version": "1.0.0",
  "description": "Tùy chỉnh màu sắc giao diện Zalo.",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "128": "icon.png"
    },
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://chat.zalo.me/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.zalo.me/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "scripting"
  ]
}